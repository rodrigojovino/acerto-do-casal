rules_version = '2';

// Comprovantes dos gastos: groups/{groupId}/receipts/{expenseId}.jpg
// - membros do grupo leem;
// - só quem lançou o gasto envia, troca ou apaga a foto, e só se o gasto
//   tiver comprovante do tipo foto;
// - só JPEG (comprimido no aparelho abaixo de 500 KB), até 1 MB.
// Cada operação faz uma única leitura no Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    function groupDoc(groupId) {
      return firestore.get(/databases/(default)/documents/groups/$(groupId));
    }

    function expenseDoc(groupId, fileName) {
      return firestore.get(/databases/(default)/documents/groups/$(groupId)/expenses/$(fileName.split('[.]')[0]));
    }

    match /groups/{groupId}/receipts/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in groupDoc(groupId).data.members;

      allow create, update: if request.auth != null
        && fileName.matches('[A-Za-z0-9_-]{1,64}[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024
        && expenseDoc(groupId, fileName).data.createdBy == request.auth.uid
        && expenseDoc(groupId, fileName).data.receipt.type == 'photo';

      allow delete: if request.auth != null
        && expenseDoc(groupId, fileName).data.createdBy == request.auth.uid;
    }

    // Comprovantes PIX do acerto: groups/{groupId}/settlements/{YYYY-MM}/{paymentId}.jpg
    // - membros leem;
    // - membros enviam enquanto o mês não está fechado (quem paga e o valor, a
    //   Function registerPayment confere); sem trocar nem apagar depois;
    // - só JPEG, até 1 MB.
    function monthPath(groupId, month) {
      return /databases/(default)/documents/groups/$(groupId)/months/$(month);
    }

    match /groups/{groupId}/settlements/{month}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in groupDoc(groupId).data.members;

      allow create: if request.auth != null
        && resource == null
        && month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
        && fileName.matches('[A-Za-z0-9]{8,40}[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024
        && request.auth.uid in groupDoc(groupId).data.members
        && (!firestore.exists(monthPath(groupId, month))
            || firestore.get(monthPath(groupId, month)).data.status != 'closed');
    }
  }
}
