rules_version = '2';

// Acesso só para os membros do grupo. Grupo, convite e vínculo são criados
// e alterados apenas pelas Cloud Functions (Admin SDK, que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.members;
    }

    // Preferências de aviso e aparelhos (push): cada um lê e grava só os próprios.
    // As Functions leem para enviar os avisos e apagam tokens recusados pelo FCM.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notificationPrefs'])
        && request.resource.data.notificationPrefs is map
        && request.resource.data.notificationPrefs.keys().hasOnly(['expenses', 'returns', 'settlement', 'recurring'])
        && request.resource.data.notificationPrefs.values().hasOnly([true, false]);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && deviceId.matches('^[A-Za-z0-9_-]{8,64}$')
          && request.resource.data.keys().hasOnly(['token', 'platform', 'appVersion', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.appVersion is string
          && request.resource.data.appVersion.size() <= 32
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Vínculo usuário → grupo: cada um lê só o próprio.
    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, delete: if false;

      // Membro altera só a divisão padrão e o próprio nome.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['defaultSplitPct', 'memberNames'])
        && request.resource.data.defaultSplitPct is int
        && request.resource.data.defaultSplitPct >= 0
        && request.resource.data.defaultSplitPct <= 100
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() >= 1
        && request.resource.data.memberNames[request.auth.uid].size() <= 60;

      // ---- Meses (competência) ----

      function monthPath(month) {
        return /databases/$(database)/documents/groups/$(groupId)/months/$(month);
      }

      // 'YYYY-MM' ou 'YYYY-MM-DD' → índice do mês (ano * 12 + mês - 1).
      function monthIndex(s) {
        return int(s.split('-')[0]) * 12 + int(s.split('-')[1]) - 1;
      }

      // Mês sem documento = aberto. Mês futuro (em UTC) nunca está fechado (o
      // fechamento só vale até o mês atual): não gasta leitura, o que permite
      // lançar uma série de até 48 parcelas num só lote.
      function isClosed(month) {
        return monthIndex(month) <= request.time.year() * 12 + request.time.month() - 1
          && exists(monthPath(month))
          && get(monthPath(month)).data.status == 'closed';
      }

      // Fechar e reabrir chegam na Fase 6 (por Function); o app só lê.
      match /months/{month} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      // ---- Gastos ----

      // Limite: até o fim do mês seguinte ao atual. Em UTC (3h à frente de
      // São Paulo), então na virada do mês a regra fica mais permissiva que o
      // app, nunca mais restritiva. O app valida no fuso de São Paulo.
      function withinLimit(s) {
        return monthIndex(s) <= request.time.year() * 12 + request.time.month();
      }

      // Competência: o mês da data; se ele estiver fechado, um mês posterior
      // aberto (o app usa o mês aberto atual). Nunca um mês fechado.
      function validCompetence(data) {
        let dateMonth = data.date.split('-')[0] + '-' + data.date.split('-')[1];
        return !isClosed(data.competence)
          && (isInstallment(data) || withinLimit(data.competence))
          && (data.competence == dateMonth
              || (data.competence > dateMonth && isClosed(dateMonth)));
      }

      function photoPath(expenseId) {
        return 'groups/' + groupId + '/receipts/' + expenseId + '.jpg';
      }

      // Comprovante gravado pelo app. `isNew`: criação (foto ainda não enviada).
      // Chave de documento fiscal (tipo 'nfce'): NF-e (modelo 55) ou NFC-e (65)
      // de qualquer estado, lida (QR ou código de barras) ou digitada (`entry`).
      // O dígito verificador é conferido no app e na Function (as regras não
      // calculam o módulo 11):
      // - NFC-e de SP: só 'pending', com a URL de consulta montada da própria
      //   chave (`...?p=chave|3|1`), igual para QR, código de barras e digitada;
      // - NF-e (qualquer estado) e NFC-e de outros estados: só 'unchecked', sem
      //   URL (sem conferência automática; a consulta de NF-e exige captcha).
      // O app nunca grava 'ok'/'failed' nem nfceData. Na edição, o comprovante
      // pode ser mantido exatamente como está (inclusive já conferido).
      // Foto da nota anexada à chave (opcional): no caminho do dono, não enviada na criação.
      function validKeyPhoto(r, ownerId, isNew) {
        return !r.keys().hasAny(['photoPath', 'photoUploaded'])
          || r.keys().hasAll(['photoPath', 'photoUploaded'])
            && r.photoPath == photoPath(ownerId)
            && r.photoUploaded is bool
            && (!isNew || r.photoUploaded == false);
      }

      // `ownerId`: o gasto (ou, numa parcela, a série) dono da foto.
      function validReceipt(r, ownerId, isNew) {
        return r.type == 'none' && r.keys().hasOnly(['type'])
          || r.type == 'photo'
            && r.keys().hasOnly(['type', 'photoPath', 'photoUploaded'])
            && r.photoPath == photoPath(ownerId)
            && r.photoUploaded is bool
            && (!isNew || r.photoUploaded == false)
          || r.type == 'nfce'
            && (
              !isNew && r == resource.data.receipt
              // Mesma chave, só a foto anexada, trocada ou removida (a conferência fica).
              || !isNew
                && resource.data.receipt.type == 'nfce'
                && r.diff(resource.data.receipt).affectedKeys().hasOnly(['photoPath', 'photoUploaded'])
                && validKeyPhoto(r, ownerId, false)
              || r.nfceKey is string
                && r.nfceKey.matches('^[0-9]{20}(55|65)[0-9]{22}$')
                && r.get('entry', null) in ['read', 'typed']
                && (
                  r.keys().hasOnly(['type', 'nfceKey', 'entry', 'nfceUrl', 'nfceStatus', 'photoPath', 'photoUploaded'])
                    && validKeyPhoto(r, ownerId, isNew)
                    && r.nfceStatus == 'pending'
                    && r.nfceKey.matches('^35[0-9]{18}65[0-9]{22}$')
                    && r.nfceUrl == 'https://www.nfce.fazenda.sp.gov.br/NFCeConsultaPublica/Paginas/ConsultaQRCode.aspx?p='
                         + r.nfceKey + '|3|1'
                  || r.keys().hasOnly(['type', 'nfceKey', 'entry', 'nfceStatus', 'photoPath', 'photoUploaded'])
                    && validKeyPhoto(r, ownerId, isNew)
                    && r.nfceStatus == 'unchecked'
                    && !r.nfceKey.matches('^35[0-9]{18}65[0-9]{22}$')
                )
            );
      }

      // ---- Parcelas ----
      // Cada parcela é um gasto com installment { seriesId, index, count,
      // firstMonth, purchaseCents }; a parcela 1 tem o id da série, as outras
      // `{série}-{índice}`. O valor da parcela é floor(total / n), com o resto
      // dos centavos na primeira.
      // O comprovante da compra (foto da série) vale para todas. Exceção ao
      // limite de datas só dentro de série válida: o primeiro mês respeita o
      // limite, a competência é a do índice e, na criação, a parcela 1 da mesma
      // série (mesmo número de parcelas e primeiro mês) existe, do mesmo autor.

      function isInstallment(data) {
        return data.keys().hasAny(['installment']);
      }

      function receiptOwner(data, expenseId) {
        return isInstallment(data) ? data.installment.seriesId : expenseId;
      }

      function validInstallment(data, expenseId, isNew) {
        let i = data.installment;
        return i is map
          && i.keys().hasAll(['seriesId', 'index', 'count', 'firstMonth', 'purchaseCents'])
          && i.keys().hasOnly(['seriesId', 'index', 'count', 'firstMonth', 'purchaseCents'])
          && i.seriesId is string && i.seriesId.matches('^[A-Za-z0-9]{1,40}$')
          && i.count is int && i.count >= 2 && i.count <= 48
          && i.index is int && i.index >= 1 && i.index <= i.count
          && i.firstMonth is string && i.firstMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && i.purchaseCents is int && i.purchaseCents >= i.count
          && data.totalCents == (i.index == 1
               ? i.purchaseCents - math.floor(i.purchaseCents / i.count) * (i.count - 1)
               : math.floor(i.purchaseCents / i.count))
          && withinLimit(i.firstMonth)
          && monthIndex(data.competence) == monthIndex(i.firstMonth) + i.index - 1
          && expenseId == (i.index == 1 ? i.seriesId : i.seriesId + '-' + string(i.index))
          && (i.index == 1 || !isNew || firstInstallmentMatches(i));
      }

      function firstInstallmentMatches(i) {
        let first = getAfter(/databases/$(database)/documents/groups/$(groupId)/expenses/$(i.seriesId)).data;
        return first.get('installment', null)
            == { 'seriesId': i.seriesId, 'index': 1, 'count': i.count, 'firstMonth': i.firstMonth, 'purchaseCents': i.purchaseCents }
          && first.createdBy == request.auth.uid;
      }

      // Observação opcional, até 300 caracteres (vazia: o campo não existe).
      function validNote(data) {
        return !data.keys().hasAny(['note'])
          || data.note is string && data.note.trim().size() >= 1 && data.note.size() <= 300;
      }

      function validExpense(data, expenseId, isNew) {
        return validNote(data)
          && data.description is string
          && data.description.trim().size() >= 1
          && data.description.size() <= 80
          && data.totalCents is int
          && data.totalCents > 0
          && data.personalCents is int
          && data.personalCents >= 0
          && data.personalCents <= data.totalCents
          && data.payerSharePct is int
          && data.payerSharePct >= 0
          && data.payerSharePct <= 100
          && data.payerUid in get(groupPath(groupId)).data.members
          && data.date is string
          && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && data.competence is string
          && data.competence.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && (isInstallment(data) ? validInstallment(data, expenseId, isNew) : withinLimit(data.date))
          && data.receipt is map
          && validReceipt(data.receipt, receiptOwner(data, expenseId), isNew)
          && validCompetence(data);
      }

      function expenseKeys() {
        return ['description', 'totalCents', 'personalCents', 'payerUid', 'payerSharePct',
                'date', 'competence', 'receipt', 'status', 'createdBy', 'createdAt', 'updatedAt'];
      }

      // ---- Quem lança (autor) ----
      // Só a criação com comprovante confirma automaticamente:
      // - criar: sem comprovante, pendente; com foto ou QR, confirmado (contestável);
      // - editar um confirmado (automático ou aprovado) ou um devolvido: pendente,
      //   com aprovação explícita do outro membro;
      // - editar um pendente: continua pendente, exceto ao anexar comprovante
      //   (o gasto nunca foi aprovado), que o confirma.
      // Nunca grava aprovação nem recusa.
      function authorStatus(data, isNew) {
        return !isNew && resource.data.status in ['confirmed', 'returned'] || data.receipt.type == 'none'
          ? 'pending_approval'
          : 'confirmed';
      }

      // recurringId: só a Function grava (gasto gerado de conta recorrente); o
      // app não cria gasto recorrente e, ao editar um gerado, não muda o campo.
      // installment: só na criação; na edição de uma parcela, a série, o valor,
      // a parte pessoal e a data ficam (para mudá-los, exclui e lança de novo).
      function isAuthorWrite(isNew) {
        return request.resource.data.keys().hasOnly(expenseKeys().concat(['recurringId', 'installment', 'note']))
          && request.resource.data.keys().hasAll(expenseKeys())
          && (isNew
                ? !request.resource.data.keys().hasAny(['recurringId'])
                : request.resource.data.get('recurringId', null) == resource.data.get('recurringId', null)
                  && request.resource.data.get('installment', null) == resource.data.get('installment', null)
                  && (
                    !isInstallment(resource.data)
                    || !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['totalCents', 'personalCents', 'date', 'competence'])
                  ))
          && request.resource.data.status == authorStatus(request.resource.data, isNew)
          && request.resource.data.updatedAt == request.time;
      }

      // Marca de foto enviada (fila de fotos): só vira photoUploaded para true,
      // sem tocar em mais nada, inclusive o status (vale para devolvido também).
      function isPhotoUploadedMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt', 'updatedAt'])
          && (resource.data.receipt.type == 'photo' || resource.data.receipt.keys().hasAny(['photoPath']))
          && request.resource.data.receipt.diff(resource.data.receipt).affectedKeys().hasOnly(['photoUploaded'])
          && request.resource.data.receipt.photoUploaded == true
          && request.resource.data.updatedAt == request.time;
      }

      // Nova consulta da NFC-e de SP que falhou ("Consultar de novo"): só volta
      // a conferência para 'pending', sem mexer em mais nada (nem no status).
      function isNfceRetry() {
        let old = resource.data.receipt;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt', 'updatedAt'])
          && old.type == 'nfce'
          && old.nfceStatus == 'failed'
          && old.keys().hasAny(['nfceUrl'])
          && request.resource.data.receipt.diff(old).affectedKeys().hasOnly(['nfceStatus', 'nfceData', 'nfceError'])
          && request.resource.data.receipt.nfceStatus == 'pending'
          && !request.resource.data.receipt.keys().hasAny(['nfceData', 'nfceError'])
          && request.resource.data.updatedAt == request.time;
      }

      // ---- O outro membro ----
      // Mexe só em status, approval/rejection e updatedAt:
      // - gasto pendente: aprova ou recusa (motivo opcional);
      // - gasto confirmado automaticamente (por comprovante, pela conferência
      //   do QR ou recorrente fixo): valida (grava a própria aprovação, sem mudar
      //   o status) ou contesta, com motivo obrigatório.
      // Gasto aprovado ou validado pelo outro membro não é contestável.
      function isReviewWrite() {
        return resource.data.createdBy != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approval', 'rejection', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (
            resource.data.status == 'pending_approval' && (isApproval() || isRejection('reject'))
            || isAutoConfirmed() && (isApproval() || isRejection('contest'))
          );
      }

      // Confirmado sem aprovação de pessoa: pelo comprovante (sem approval) ou
      // pela conferência do QR da versão anterior (approval.byUid 'nfce').
      function isAutoConfirmed() {
        return resource.data.status == 'confirmed'
          && (!resource.data.keys().hasAny(['approval']) || resource.data.approval.byUid == 'nfce');
      }

      function isApproval() {
        return request.resource.data.status == 'confirmed'
          && request.resource.data.approval == { 'byUid': request.auth.uid, 'at': request.time }
          && !request.resource.data.keys().hasAny(['rejection']);
      }

      // Recusar (motivo opcional) ou contestar (motivo obrigatório), até 200 caracteres.
      function isRejection(kind) {
        let r = request.resource.data.rejection;
        return request.resource.data.status == 'returned'
          && !request.resource.data.keys().hasAny(['approval'])
          && r.keys().hasAll(['byUid', 'at', 'kind'])
          && r.keys().hasOnly(['byUid', 'at', 'kind', 'reason'])
          && r.byUid == request.auth.uid
          && r.at == request.time
          && r.kind == kind
          && (
            kind == 'contest'
              && r.keys().hasAny(['reason']) && r.reason is string
              && r.reason.trim().size() >= 1 && r.reason.size() <= 200
            || kind == 'reject'
              && (!r.keys().hasAny(['reason']) || r.reason is string && r.reason.size() <= 200)
          );
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);

        // Sem comprovante nasce pendente; com foto ou QR, confirmado.
        allow create: if isMember(groupId)
          && isAuthorWrite(true)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && validExpense(request.resource.data, expenseId, true);

        // Autor: edita (status pelo comprovante; devolvido vai para aprovação;
        // descarta aprovação/recusa). Outro membro: aprova, recusa ou contesta.
        // Nunca em mês fechado (a contestação vale até o fechamento).
        allow update: if isMember(groupId)
          && !isClosed(resource.data.competence)
          && (
            resource.data.createdBy == request.auth.uid
              && isAuthorWrite(false)
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.createdAt == resource.data.createdAt
              && validExpense(request.resource.data, expenseId, false)
            || resource.data.createdBy == request.auth.uid && isPhotoUploadedMark()
            || resource.data.createdBy == request.auth.uid && isNfceRetry()
            || isReviewWrite()
          );

        allow delete: if isMember(groupId)
          && resource.data.createdBy == request.auth.uid
          && !isClosed(resource.data.competence);
      }

      // ---- Itens da nota (NFC-e de SP) ----
      // Um documento por chave, gravado só pela Function de conferência (e pela
      // reconsulta, com credencial de dono). Membros leem; o app não grava.
      match /nfceItems/{nfceKey} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      // ---- Contas recorrentes ----
      // Fixo novo: vai para aprovação do outro membro. Variável: não precisa de
      // aprovação (cada mês passa pela confirmação do valor). Num cadastro já
      // aprovado, os campos de dinheiro (tipo, valor, quem paga, divisão) são
      // sempre a versão aprovada, que a geração usa; mudá-los com fixo de um dos
      // lados vira reajuste em `proposal`, que só vale quando o outro aprovar.
      // Só quem cadastrou edita; qualquer um dos dois desativa. A geração dos
      // gastos é da Function (lastGeneratedMonth).

      function recurringKeys() {
        return ['description', 'kind', 'dayOfMonth', 'payerUid', 'payerSharePct', 'startMonth',
                'active', 'status', 'createdBy', 'createdAt', 'updatedAt'];
      }

      function validRecurring(d) {
        return d.keys().hasAll(recurringKeys())
          && d.keys().hasOnly(recurringKeys().concat(['amountCents', 'endMonth', 'approval', 'rejection', 'proposal', 'lastGeneratedMonth']))
          && d.description is string
          && d.description.trim().size() >= 1
          && d.description.size() <= 80
          && (
            d.kind == 'fixed' && d.amountCents is int && d.amountCents > 0
            || d.kind == 'variable' && !d.keys().hasAny(['amountCents'])
          )
          && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31
          && d.payerUid in get(groupPath(groupId)).data.members
          && d.payerSharePct is int && d.payerSharePct >= 0 && d.payerSharePct <= 100
          && d.startMonth is string && d.startMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && (
            !d.keys().hasAny(['endMonth'])
            || d.endMonth is string && d.endMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && d.endMonth >= d.startMonth
          )
          && d.active is bool;
      }

      // Campos de dinheiro (de um cadastro ou de um reajuste), para comparar.
      function recurringTerms(d) {
        return {
          'kind': d.kind,
          'amountCents': d.get('amountCents', null),
          'payerUid': d.payerUid,
          'payerSharePct': d.payerSharePct
        };
      }

      function validProposal(p) {
        return p is map
          && p.keys().hasAll(['kind', 'payerUid', 'payerSharePct', 'at'])
          && p.keys().hasOnly(['kind', 'amountCents', 'payerUid', 'payerSharePct', 'at'])
          && (
            p.kind == 'fixed' && p.amountCents is int && p.amountCents > 0
            || p.kind == 'variable' && !p.keys().hasAny(['amountCents'])
          )
          && p.payerUid in get(groupPath(groupId)).data.members
          && p.payerSharePct is int && p.payerSharePct >= 0 && p.payerSharePct <= 100
          && p.at == request.time;
      }

      // Status que o autor grava num cadastro ainda não aprovado (novo, pendente
      // ou recusado): variável já aprovado; fixo vai para aprovação.
      function recurringAuthorStatus() {
        return request.resource.data.kind == 'variable' ? 'approved' : 'pending_approval';
      }

      function isRecurringRejection() {
        return request.resource.data.rejection.keys().hasAll(['byUid', 'at', 'kind'])
          && request.resource.data.rejection.keys().hasOnly(['byUid', 'at', 'kind', 'reason'])
          && request.resource.data.rejection.byUid == request.auth.uid
          && request.resource.data.rejection.at == request.time
          && request.resource.data.rejection.kind == 'reject'
          && (
            !request.resource.data.rejection.keys().hasAny(['reason'])
            || request.resource.data.rejection.reason is string
              && request.resource.data.rejection.reason.size() <= 200
          );
      }

      // Edição de quem cadastrou num cadastro aprovado: aprovação e versão
      // aprovada mantidas; sem reajuste, o dinheiro só muda direto entre
      // variáveis; com reajuste, ele difere da versão aprovada e envolve fixo.
      function isApprovedAuthorEdit() {
        return request.resource.data.status == 'approved'
          && request.resource.data.get('approval', null) == resource.data.get('approval', null)
          && (
            !request.resource.data.keys().hasAny(['proposal'])
              && (
                recurringTerms(request.resource.data) == recurringTerms(resource.data)
                || resource.data.kind == 'variable' && request.resource.data.kind == 'variable'
              )
            || request.resource.data.keys().hasAny(['proposal'])
              && recurringTerms(request.resource.data) == recurringTerms(resource.data)
              && (
                request.resource.data.proposal == resource.data.get('proposal', null)
                || validProposal(request.resource.data.proposal)
              )
              && recurringTerms(request.resource.data.proposal) != recurringTerms(resource.data)
              && (request.resource.data.proposal.kind == 'fixed' || resource.data.kind == 'fixed')
          );
      }

      match /recurring/{recurringId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId)
          && validRecurring(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.active == true
          && !request.resource.data.keys().hasAny(['approval', 'rejection', 'proposal', 'lastGeneratedMonth'])
          && request.resource.data.status == recurringAuthorStatus();

        allow update: if isMember(groupId) && (
          // Quem cadastrou edita. A recusa anterior é sempre descartada.
          resource.data.createdBy == request.auth.uid
            && validRecurring(request.resource.data)
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('lastGeneratedMonth', null) == resource.data.get('lastGeneratedMonth', null)
            && !request.resource.data.keys().hasAny(['rejection'])
            && (
              resource.data.status == 'approved'
                ? isApprovedAuthorEdit()
                : request.resource.data.status == recurringAuthorStatus()
                  && !request.resource.data.keys().hasAny(['approval', 'proposal'])
            )
          // O outro membro aprova ou recusa um fixo novo pendente.
          || resource.data.createdBy != request.auth.uid
            && resource.data.status == 'pending_approval'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approval', 'rejection', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && (
              request.resource.data.status == 'approved'
                && request.resource.data.approval == { 'byUid': request.auth.uid, 'at': request.time }
                && !request.resource.data.keys().hasAny(['rejection'])
              || request.resource.data.status == 'returned'
                && !request.resource.data.keys().hasAny(['approval'])
                && isRecurringRejection()
            )
          // O outro membro aprova o reajuste (passa a ser a versão aprovada) ou o
          // recusa (some; a versão aprovada continua). O status não muda.
          || resource.data.createdBy != request.auth.uid
            && resource.data.status == 'approved'
            && resource.data.keys().hasAny(['proposal'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['kind', 'amountCents', 'payerUid', 'payerSharePct', 'proposal', 'approval', 'rejection', 'updatedAt'])
            && !request.resource.data.keys().hasAny(['proposal'])
            && request.resource.data.updatedAt == request.time
            && (
              recurringTerms(request.resource.data) == recurringTerms(resource.data.proposal)
                && request.resource.data.approval == { 'byUid': request.auth.uid, 'at': request.time }
                && !request.resource.data.keys().hasAny(['rejection'])
              || recurringTerms(request.resource.data) == recurringTerms(resource.data)
                && request.resource.data.get('approval', null) == resource.data.get('approval', null)
                && isRecurringRejection()
            )
          // Qualquer um dos dois desativa.
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
            && resource.data.active == true
            && request.resource.data.active == false
            && request.resource.data.updatedAt == request.time
        );

        // Excluir o cadastro não apaga os gastos já gerados.
        allow delete: if isMember(groupId) && resource.data.createdBy == request.auth.uid;
      }

      // Qualquer outra subcoleção fica fechada (sem regra = negado).
    }

    // invites, joinAttempts e qualquer outra coleção: só as Functions.
  }
}
