rules_version = '2';

// Acesso só para os membros do grupo. Grupo, convite e vínculo são criados
// e alterados apenas pelas Cloud Functions (Admin SDK, que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && request.auth.uid in get(groupPath(groupId)).data.members;
    }

    // Vínculo usuário → grupo: cada um lê só o próprio.
    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, delete: if false;

      // Membro altera só a divisão padrão e o próprio nome.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['defaultSplitPct', 'memberNames'])
        && request.resource.data.defaultSplitPct is int
        && request.resource.data.defaultSplitPct >= 0
        && request.resource.data.defaultSplitPct <= 100
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() >= 1
        && request.resource.data.memberNames[request.auth.uid].size() <= 60;

      // ---- Meses (competência) ----

      function monthPath(month) {
        return /databases/$(database)/documents/groups/$(groupId)/months/$(month);
      }

      // Mês sem documento = aberto.
      function isClosed(month) {
        return exists(monthPath(month)) && get(monthPath(month)).data.status == 'closed';
      }

      // Fechar e reabrir chegam na Fase 6 (por Function); o app só lê.
      match /months/{month} {
        allow read: if isMember(groupId);
        allow write: if false;
      }

      // ---- Gastos ----

      // 'YYYY-MM' ou 'YYYY-MM-DD' → índice do mês (ano * 12 + mês - 1).
      function monthIndex(s) {
        return int(s.split('-')[0]) * 12 + int(s.split('-')[1]) - 1;
      }

      // Limite: até o fim do mês seguinte ao atual. Em UTC (3h à frente de
      // São Paulo), então na virada do mês a regra fica mais permissiva que o
      // app, nunca mais restritiva. O app valida no fuso de São Paulo.
      function withinLimit(s) {
        return monthIndex(s) <= request.time.year() * 12 + request.time.month();
      }

      // Competência: o mês da data; se ele estiver fechado, um mês posterior
      // aberto (o app usa o mês aberto atual). Nunca um mês fechado.
      function validCompetence(data) {
        let dateMonth = data.date.split('-')[0] + '-' + data.date.split('-')[1];
        return !isClosed(data.competence)
          && withinLimit(data.competence)
          && (data.competence == dateMonth
              || (data.competence > dateMonth && isClosed(dateMonth)));
      }

      function photoPath(expenseId) {
        return 'groups/' + groupId + '/receipts/' + expenseId + '.jpg';
      }

      // Comprovante gravado pelo app. `isNew`: criação (foto ainda não enviada).
      // QR: o app só grava 'pending' e nunca os dados da nota; só a Function
      // grava 'ok'/'failed' e nfceData. Na edição, o QR pode ser mantido como
      // está (inclusive já conferido) ou trocado/reconsultado como 'pending'.
      function validReceipt(r, expenseId, isNew) {
        return r.type == 'none' && r.keys().hasOnly(['type'])
          || r.type == 'photo'
            && r.keys().hasOnly(['type', 'photoPath', 'photoUploaded'])
            && r.photoPath == photoPath(expenseId)
            && r.photoUploaded is bool
            && (!isNew || r.photoUploaded == false)
          || r.type == 'nfce'
            && r.keys().hasOnly(['type', 'nfceKey', 'nfceUrl', 'nfceStatus', 'nfceData', 'nfceError'])
            && r.nfceKey is string && r.nfceKey.matches('^[0-9]{44}$')
            && r.nfceUrl is string && r.nfceUrl.size() <= 600
            && r.nfceUrl.matches('^https://www[.]nfce[.]fazenda[.]sp[.]gov[.]br/.*')
            && (
              r.nfceStatus == 'pending' && !r.keys().hasAny(['nfceData', 'nfceError'])
              || !isNew && r == resource.data.receipt
            );
      }

      function validExpense(data, expenseId, isNew) {
        return data.description is string
          && data.description.trim().size() >= 1
          && data.description.size() <= 80
          && data.totalCents is int
          && data.totalCents > 0
          && data.personalCents is int
          && data.personalCents >= 0
          && data.personalCents <= data.totalCents
          && data.payerSharePct is int
          && data.payerSharePct >= 0
          && data.payerSharePct <= 100
          && data.payerUid in get(groupPath(groupId)).data.members
          && data.date is string
          && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && withinLimit(data.date)
          && data.competence is string
          && data.competence.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.receipt is map
          && validReceipt(data.receipt, expenseId, isNew)
          && validCompetence(data);
      }

      function expenseKeys() {
        return ['description', 'totalCents', 'personalCents', 'payerUid', 'payerSharePct',
                'date', 'competence', 'receipt', 'status', 'createdBy', 'createdAt', 'updatedAt'];
      }

      // ---- Quem lança (autor) ----
      // Nunca grava `confirmed` nem aprovação/recusa: só a aprovação do outro
      // membro ou a Function (QR conferido) confirmam.
      function isAuthorWrite() {
        return request.resource.data.keys().hasOnly(expenseKeys())
          && request.resource.data.keys().hasAll(expenseKeys())
          && request.resource.data.status == 'pending_approval'
          && request.resource.data.updatedAt == request.time;
      }

      // Marca de foto enviada (fila de fotos): só vira photoUploaded para true,
      // sem tocar em mais nada, inclusive o status (vale para devolvido também).
      function isPhotoUploadedMark() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt', 'updatedAt'])
          && resource.data.receipt.type == 'photo'
          && request.resource.data.receipt.diff(resource.data.receipt).affectedKeys().hasOnly(['photoUploaded'])
          && request.resource.data.receipt.photoUploaded == true
          && request.resource.data.updatedAt == request.time;
      }

      // ---- Quem aprova ou recusa (o outro membro) ----
      // Mexe só em status, approval/rejection e updatedAt, e só em gasto pendente.
      function isReviewWrite() {
        return resource.data.createdBy != request.auth.uid
          && resource.data.status == 'pending_approval'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'approval', 'rejection', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (isApproval() || isRejection());
      }

      // Aprovar: foto só depois de enviada.
      function isApproval() {
        return request.resource.data.status == 'confirmed'
          && request.resource.data.approval == { 'byUid': request.auth.uid, 'at': request.time }
          && !request.resource.data.keys().hasAny(['rejection'])
          && (resource.data.receipt.type != 'photo' || resource.data.receipt.photoUploaded == true);
      }

      // Recusar: motivo opcional, até 200 caracteres.
      function isRejection() {
        let r = request.resource.data.rejection;
        return request.resource.data.status == 'returned'
          && !request.resource.data.keys().hasAny(['approval'])
          && r.keys().hasAll(['byUid', 'at'])
          && r.keys().hasOnly(['byUid', 'at', 'reason'])
          && r.byUid == request.auth.uid
          && r.at == request.time
          && (!r.keys().hasAny(['reason']) || r.reason is string && r.reason.size() <= 200);
      }

      match /expenses/{expenseId} {
        allow read: if isMember(groupId);

        // Todo gasto nasce pendente de aprovação, com qualquer comprovante.
        allow create: if isMember(groupId)
          && isAuthorWrite()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && validExpense(request.resource.data, expenseId, true);

        // Autor: edita (volta a pendente, descarta aprovação/recusa).
        // Outro membro: aprova ou recusa. Nunca em mês fechado.
        allow update: if isMember(groupId)
          && !isClosed(resource.data.competence)
          && (
            resource.data.createdBy == request.auth.uid
              && isAuthorWrite()
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.createdAt == resource.data.createdAt
              && validExpense(request.resource.data, expenseId, false)
            || resource.data.createdBy == request.auth.uid && isPhotoUploadedMark()
            || isReviewWrite()
          );

        allow delete: if isMember(groupId)
          && resource.data.createdBy == request.auth.uid
          && !isClosed(resource.data.competence);
      }

      // Recorrentes chegam na Fase 5; até lá, fechado.
      // Qualquer outra subcoleção também fica fechada (sem regra = negado).
    }

    // invites, joinAttempts e qualquer outra coleção: só as Functions.
  }
}
