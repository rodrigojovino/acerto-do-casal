{
  "name": "acerto-do-casal",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start --project acerto-do-casal",
    "recorrentes:gerar": "node scripts/dev/gerar-recorrentes.mjs",
    "test:emulators": "npm run functions:build && firebase emulators:exec --project demo-acerto --only auth,firestore,functions,storage \"vitest run -c vitest.emulators.config.ts\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@capawesome/capacitor-badge": "8.0.4",
    "@fontsource/manrope": "5.3.0",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "firebase": "^12.19.0",
    "idb-keyval": "6.3.0",
    "ionicons": "^8.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "firebase-tools": "^15.32.1",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  }
}
