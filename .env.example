# Copie para .env e preencha com a config web do projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
# No GitHub Actions, os mesmos nomes ficam em Settings > Secrets and variables > Actions > Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
